{% extends 'base.html.twig' %}



{% block body %}

    <div class="container my-5">
        <h1>{{ category.name }}</h1>


        <h5>cette categorie contient {{ category.products | length }} produit(s)</h5>
  
        <div class="row">
             {% for product in category.products %}
        
         <div class="col-md-3 text-center">
         <a class="text-decoration-none" href="{{ path('app_product', { slug: product.slug }) }}">
        <img src="/uploads/{{ product.illustration }}" class="img-fluid" style="max-height: 200px; object-fit: cover;">
        <span class="d-block fw-bold text-black">{{ product.name }} </span>

        </a>
        <span class="d-block">{{ product.priceWt | price }}</span>
        </div>
            {% endfor %}
        </div>

                 
           

    
        
              
    </div>

{% endblock %}
